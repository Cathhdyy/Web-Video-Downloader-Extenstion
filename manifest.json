{
  "manifest_version": 3,
  "name": "MediaGrabber PRO - Video & MP3 Downloader",
  "version": "1.1.0",
  "description": "Sniff, preview, and download videos, audio, and MP3 streams from web pages with built-in HLS stream support and MP4 conversion.",
  "permissions": [
    "webRequest",
    "declarativeNetRequest",
    "storage",
    "downloads",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MediaGrabber PRO",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
